# Load required libraries
library(ggplot2)
library(reshape2)
library(dplyr)
# Reshape data from wide to long format for plotting
data_long <- reshape2::melt(data, id.vars = "ParticipantID",
variable.name = "Variable",
value.name = "Likert_Score")
# Create the line plot
plot <- ggplot(data_long, aes(x = Variable, y = Likert_Score,
group = ParticipantID, color = ParticipantID)) +
geom_line(size = 1, alpha = 0.8) +
geom_point(size = 2, alpha = 0.8) +
scale_y_continuous(breaks = 1:5,
labels = c("Strongly\nDislike", "Dislike", "Neutral", "Like", "Strongly\nLike"),
limits = c(0.5, 5.5)) +
scale_x_discrete(labels = function(x) gsub("_", "\n", x)) +  # Replace underscores with line breaks
labs(title = "Individual Likert Scale Responses Across Variables",
subtitle = "Each line represents one participant's responses",
x = "Variables",
y = "Likert Scale Response",
color = "Participant") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1, size = 9),
axis.text.y = element_text(size = 9),
legend.position = "right",
plot.title = element_text(size = 14, face = "bold"),
plot.subtitle = element_text(size = 11),
panel.grid.minor = element_blank(),
panel.grid.major.x = element_line(color = "gray90", linetype = "dashed")) +
guides(color = guide_legend(override.aes = list(size = 3)))
# Display the plot
print(plot)
# Alternative version with better spacing and colors
plot2 <- ggplot(data_long, aes(x = Variable, y = Likert_Score,
group = ParticipantID, color = ParticipantID)) +
geom_line(size = 1.2, alpha = 0.7) +
geom_point(size = 3, alpha = 0.9) +
scale_y_continuous(breaks = 1:5,
labels = c("1\nStrongly\nDislike", "2\nDislike", "3\nNeutral", "4\nLike", "5\nStrongly\nLike"),
limits = c(0.8, 5.2)) +
scale_color_brewer(type = "qual", palette = "Paired") +
labs(title = "Likert Scale Response Patterns by Participant",
subtitle = "Individual response profiles across music, sports, and hobby variables",
x = "\nVariables",
y = "Likert Scale Score\n",
color = "Participant\nID") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1, size = 10, face = "bold"),
axis.text.y = element_text(size = 9),
axis.title = element_text(size = 12, face = "bold"),
legend.position = "right",
plot.title = element_text(size = 16, face = "bold", hjust = 0.5),
plot.subtitle = element_text(size = 12, hjust = 0.5),
panel.grid.minor = element_blank(),
panel.grid.major.x = element_line(color = "gray85", linetype = "dotted"),
panel.grid.major.y = element_line(color = "gray90"),
plot.background = element_rect(fill = "white", color = NA)) +
guides(color = guide_legend(override.aes = list(size = 4, alpha = 1)))
cat("\n=== CREATING ENHANCED PLOT ===\n")
print(plot2)
